<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    .spotify-section {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      padding: 40px 20px;
      box-sizing: border-box;
    }

    .spotify-block {
      width: 100%;
      max-width: 600px;
      padding: 16px;
      background: #181818;
      border-radius: 18px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    }

    .spotify-block iframe {
      display: block;
      width: 100%;
      height: 352px;
      border: 0;
      border-radius: 12px;
    }
  </style>
</head>

<body>

  <div class="spotify-section">
    <div class="spotify-block">
      <iframe
        src="https://open.spotify.com/embed/album/2vnRo2uvsmeVhTObZWnzBd?utm_source=generator&autoplay=1"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="eager">
      </iframe>
    </div>
  </div>

</body>
</html>

